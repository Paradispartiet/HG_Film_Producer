  "historicalObjects": [
    {
      "label": "Franchise, sequel and intellectual-property consolidation",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Studios increasingly coordinated sequels, recognizable properties, stars, merchandising and release strategy across multiple films; franchise is an industrial relation, not a genre label."
    },
    {
      "label": "Home video, cable and the expanding aftermarket",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "VHS/Betamax, rental and cable changed circulation, catalog value, censorship disputes and audience access; downstream video masters and cuts remain separate from original production evidence."
    },
    {
      "label": "High-concept marketing, saturation release and ancillary value",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Trailers, posters, music, licensing, release scale and simple-to-communicate premises became increasingly coordinated with production, without making every successful film a high-concept blockbuster."
    },
    {
      "label": "Effects, sound and post-production specialization",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Optical houses, creature and makeup effects, motion-control, miniatures, Dolby-era sound and increasingly specialized post-production labor changed both spectacle and mid-budget genre production."
    },
    {
      "label": "Broadcast finance and new British production institutions",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Channel 4 and related public/private television structures opened feature-production space for subjects, writers and filmmakers poorly served by older studio systems."
    },
    {
      "label": "American independent and specialty-distribution ecology",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Regional production, Sundance, Cannes, specialty distributors and modest budgets created new routes from local filmmaking to national and international theatrical circulation."
    },
    {
      "label": "Mainland Chinese, Hong Kong and Taiwan transformations",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Fifth Generation, Hong Kong New Wave/action industry and Taiwan New Cinema developed through distinct institutions, labor systems, censorship histories and commercial/festival relations and must never be treated as one Chinese movement."
    },
    {
      "label": "Political memory under socialism, dictatorship and democratization",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Soviet-bloc, Latin American and other political cinemas negotiated state studios, censorship, historical trauma and changing political institutions through production-specific conditions."
    },
    {
      "label": "African and transnational co-production circuits",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "African filmmakers combined national cultural institutions, cross-border finance, European partners and festival distribution under unequal access conditions; international recognition is downstream from local authorship and production."
    },
    {
      "label": "Preservation, color fading, alternate cuts and restoration",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "The decade's films often circulate today through restored, recut or home-media versions; preservation history is essential but must never overwrite original capture, release or labor evidence."
    }
  ],
