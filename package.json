{
  "name": "hg-film-producer",
  "version": "0.1.0",
  "private": true,
  "description": "Filmverket: a shared film platform containing the Film Producer game, Film Atlas, Director Lab, Film School, and Film History.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:ui": "tsc -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/core/*.test.js",
    "audit:production-cases": "node scripts/production-case-rest-audit.mjs",
    "audit:film-history-ch1": "node scripts/film-history-chapter-one-atlas-audit.mjs",
    "audit:film-history-ch2": "node scripts/film-history-chapter-two-atlas-audit.mjs",
    "audit:film-history-ch3": "node scripts/film-history-chapter-three-atlas-audit.mjs",
    "audit:film-history-ch4": "node scripts/film-history-chapter-four-atlas-audit.mjs",
    "audit:film-history-ch5": "node scripts/film-history-chapter-five-atlas-audit.mjs",
    "audit:film-history-ch6": "node scripts/film-history-chapter-six-atlas-audit.mjs",
    "audit:film-history-ch7": "node scripts/film-history-chapter-seven-atlas-audit.mjs",
    "audit:film-history-ch8": "node scripts/film-history-chapter-eight-atlas-audit.mjs",
    "audit:film-history-ch9": "node scripts/film-history-chapter-nine-atlas-audit.mjs",
    "audit:film-history-ch10": "node scripts/film-history-chapter-ten-atlas-audit.mjs",
    "audit:film-history-ch11": "node scripts/film-history-chapter-eleven-atlas-audit.mjs",
