    "audit:film-history-ch13": "node scripts/film-history-chapter-thirteen-atlas-audit.mjs",
    "audit:film-history-ch14": "node scripts/film-history-chapter-fourteen-atlas-audit.mjs",
    "audit:film-history-ch15": "node scripts/film-history-chapter-fifteen-atlas-audit.mjs",
    "audit:film-history-ch16": "node scripts/film-history-chapter-sixteen-atlas-audit.mjs",
    "audit:film-history-ch17": "node scripts/film-history-chapter-seventeen-atlas-audit.mjs",
    "audit:film-history-ch18": "node scripts/film-history-chapter-eighteen-atlas-audit.mjs",
    "audit:film-history-ch18-completion": "node scripts/film-history-chapter-eighteen-completion-audit.mjs",
    "preflight:v0.1": "node scripts/preflight-v0.1.mjs",
