    {
      "label": "Photogénie and French Impressionist film theory",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Delluc, Epstein, Dulac and others theorized cinema's capacity to transform objects, faces, movement and duration. Photogénie is a contested critical concept, not a camera preset or measurable gameplay score."
    },
    {
      "label": "Film criticism, journals, ciné-clubs and specialist cinemas",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Writing, clubs and venues helped define audiences and vocabularies for film art outside mainstream commercial circulation; these institutions enabled movements but are not films."
    },
    {
      "label": "Independent producers, patrons and alternative financing",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Avant-garde work depended on small companies, private money, artist networks and sometimes wealthy patrons, creating different freedoms and dependencies from vertically integrated studios."
    },
    {
      "label": "Dada and Surrealist artist networks",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Film intersected with poetry, painting, performance and anti-bourgeois artistic movements. Those networks shaped collaboration and exhibition but should not be converted into a single reproducible style recipe."
    },
    {
      "label": "Cinéma pur and abstract moving-image practice",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Artists explored rhythm, shape, repetition, speed and photographic transformation without conventional narrative obligations; the practice spans many shorts rather than one canonical Production Case."
    },
    {
      "label": "Alternative exhibition and event cinema",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Studio des Ursulines, Studio 28, theatre/ballet programs and ciné-club screenings created contexts where short experimental works could circulate and provoke audiences outside standard feature programs."
    },
    {
      "label": "Cross-art production design and modernist collaboration",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Architects, painters, musicians, poets and designers entered film production, making French avant-garde cinema a collaborative art-world system rather than a director-only phenomenon."
    },
    {
      "label": "Gender, authorship and unequal canon formation",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Germaine Dulac and other women were central to French avant-garde production and theory; later canons and attribution disputes can obscure that labor and must be handled explicitly."
    },
    {
      "label": "Censorship, scandal and representational harm",
      "role": "historical_object",
      "atlasDecision": "NO_PRODUCTION_CASE",
      "chapterFunction": "Provocation could trigger censorship or political reaction, while shocking images may involve real harm or vulnerable bodies. Historical analysis does not turn dangerous or exploitative acts into player objectives."
    },
